{
  "manifest_version": 3,
  "name": "Hyper RB",
  "version": "4.4.6",
  "description": "Hyper RB — Interceptor flutuante de requests/WebSockets da Lovable, com presets editáveis e captura em tempo real.",
  "permissions": [
    "storage",
    "activeTab",
    "windows",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://cvbgrjauqjawrsyknhyj.supabase.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://cvbgrjauqjawrsyknhyj.supabase.co;"
  },
  "background": {
    "service_worker": "burp_background.js"
  },
  "action": {
    "default_title": "Hyper RB — abrir painel flutuante"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ],
      "js": [
        "burp_content.js",
        "burp_floating.js"
      ],
      "css": [
        "burp_floating.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "burp_pageHook.js",
        "burp_sidepanel.html",
        "burp_sidepanel.css",
        "burp_sidepanel.js",
        "burp_chains.js",
        "burp_ai_client.js",
        "burp_ws_console.js",
        "scripts/_shared.js",
        "scripts/_registry.js",
        "scripts/*.js"
      ],
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ]
    }
  ]
}

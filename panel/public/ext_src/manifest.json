{
  "manifest_version": 3,
  "name": "HyperBuild",
   "version": "6.2",
  "description": "Extensão premium com validação de licença, modo plano e automação inteligente.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel"],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable.dev/*",
    "https://cvbgrjauqjawrsyknhyj.supabase.co/*"
  ],
  "action": {},
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://*.lovable.dev/*",
      "https://lovable.dev/*",
      "https://api.lovable.dev/*",
      "https://cvbgrjauqjawrsyknhyj.supabase.co/*",
      "https://*.supabase.co/*"
    ],
    "js": ["hwFingerprint.js", "upload-manager.js", "content-templates.js", "content.js", "burp-interceptor.js"],
    "css": ["floating.css"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["pageHook.js"],
    "matches": [
      "https://*.lovable.dev/*", 
      "https://lovable.dev/*",
      "https://cvbgrjauqjawrsyknhyj.supabase.co/*",
      "https://*.supabase.co/*"
    ]
  }]
}